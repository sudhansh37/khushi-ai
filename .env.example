# Khushi AI — copy this file to `.env` and tweak as you like.

# --- Model (any GGUF on Hugging Face) -------------------------------------
# Default: small, CPU-friendly, multilingual (Hindi + English + Hinglish).
KHUSHI_MODEL_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
KHUSHI_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf

# Hindi/Hinglish-native alternative (uncomment to use):
# KHUSHI_MODEL_REPO=eulogik/Bharat-Tiny-LLM-v3
# KHUSHI_MODEL_FILE=bharat-tiny-llm-v3-q4_k_m.gguf

# --- Performance ----------------------------------------------------------
KHUSHI_N_CTX=4096
KHUSHI_N_THREADS=0        # 0 = auto (use all CPU cores)
KHUSHI_MAX_TOKENS=512
KHUSHI_TEMPERATURE=0.7
KHUSHI_TOP_P=0.9

# --- Web research (DuckDuckGo, no API key) --------------------------------
KHUSHI_ENABLE_WEB=true
KHUSHI_WEB_MAX_RESULTS=5

# --- Server ---------------------------------------------------------------
KHUSHI_HOST=0.0.0.0
KHUSHI_PORT=8000
